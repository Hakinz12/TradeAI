# Copy to .env and adjust. Paper mode remains ON by default. Live swap execution is not enabled until wallet signing and submission are completed and tested.
PAPER_MODE=true
PORT=3000

# The dashboard API has no token authentication. Keep the service local unless separately secured.
# HOST defaults to 127.0.0.1. Set TRUST_PROXY=true only behind your own reverse proxy.
# HOST=127.0.0.1
# TRUST_PROXY=false
DB_PATH=data/tradeai.db

# ---- Data source -------------------------------------------------------------------------
# sim = built-in simulated market (plumbing test only: its results prove nothing about live profit)
# live = DexScreener + GeckoTerminal + Solana RPC. Needs Helius for internal entry risk checks and transaction intelligence;
#        without RPC, tokens remain untradable. Helius indexed history powers Volume Intelligence.
FEED=sim
# SIM_SEED=7
# HELIUS_API_KEY=            # free key from helius.dev (or set HELIUS_RPC_URL to any https RPC)
# HELIUS_RPC_URL=
# JUPITER_API_KEY=           # enables Jupiter Mainnet quote + unsigned transaction preparation
# GEMINI_API_KEY=             # Google AI Studio key; used server-side for advisory analysis
# GEMINI_MODEL=gemini-2.5-flash
# HELIUS_DEVNET_RPC_URL=https://api.devnet.solana.com
# Devnet Orca Whirlpool pools (JSON array; only verified, funded Devnet pools). Example shape in DEVNET.md.
DEVNET_ORCA_POOLS=[]
# POLL_MS=15000              # live polling interval (min 5000)
TICK_MS=2000                 # sim speed; each tick = 1 simulated minute
# RECORD_SNAPSHOTS=true      # record market data for charts and `npm run backtest -- --source db`
SOL_USD=150

# ---- Paper account and risk (every one of these is editable per strategy in the dashboard) ----
START_BALANCE_SOL=10
MAX_POSITION_PCT=5
MAX_OPEN_POSITIONS=5
MAX_EXPOSURE_PCT=35
MAX_PER_THEME=2
MAX_POOL_SHARE_PCT=1.5
STOP_LOSS_PCT=20
TRAILING_STOP_PCT=15
TP1_MULT=2
TP1_FRACTION=0.5
TAKE_PROFIT_MULT=5
MAX_HOLD_MINUTES=90
DAILY_LOSS_LIMIT_PCT=10
MIN_SCORE=0.62
MIN_LIQUIDITY_USD=15000
MAX_TOP10_HOLDER_PCT=45
MIN_HOLDERS=0
MAX_SELL_IMPACT_PCT=8
# REGIME_ENABLED=true

# ---- Pessimistic paper fills (real memecoin fills are worse than clean simulations) ----
# PESSIMISM_LATENCY_PCT=1.0
# PESSIMISM_SLIPPAGE_MULT=1.5
# PESSIMISM_FEE_PCT=0.5
# PESSIMISM_SELL_FAIL_PROB=0.25

# ---- Predictor ----
PREDICTOR=heuristic          # or "model" after training: python python/train.py (see README)
# MODEL_PATH=data/model.json

# ---- Alerts (optional) ----
# ALERT_DISCORD_WEBHOOK=
# ALERT_TELEGRAM_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=

# ---- Burner wallet, deposit and withdraw ----
# Create the burner first:  npm run wallet -- create
# Funds can ONLY be withdrawn to OWNER_WALLET (a wallet you control, never the burner itself).
# OWNER_WALLET=
# WALLET_ALERT_DROP_PCT=10
# KEYSTORE_PATH=data/burner.keystore.json
