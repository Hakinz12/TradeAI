{
  "name": "alpha-fun",
  "version": "1.0.0",
  "description": "Alpha.fun \u2014 Solana trading intelligence and wallet-approved execution terminal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "backtest": "tsx scripts/backtest.ts",
    "feed:check": "tsx scripts/feed-check.ts",
    "wallet": "tsx scripts/wallet.ts",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "reset": "node -e \"import('node:fs').then(f=>f.rmSync('data/state.json',{force:true}))\"",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "dev:web": "npm --prefix web run dev"
  },
  "dependencies": {
    "@solana-program/system": "0.16.0",
    "@solana/kit": "8.6.0",
    "better-sqlite3": "13.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "tsx": "^4.16.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
